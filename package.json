{
  "name": "pidgruntya-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "dev": "npm run images && vite --config vite.config.ts",
    "build": "npm run images && tsc -b && vite build --config vite.config.ts && vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview --config vite.config.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p functions"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
